# 复制为 .env 后按需修改;.env 已被 .gitignore 排除,禁止提交真实密钥。

# 数据库连接(PostgreSQL,无 SQLite 降级路径)
DATABASE_URL=postgresql+psycopg://mes:mes_dev_only@localhost:5432/meeting_evidence

# 独立测试库(仅 pytest 使用;应用运行时不读取)
# 必须显式配置且库名不得与 DATABASE_URL 相同,否则测试直接退出、
# 不执行任何 TRUNCATE(见 docs/DECISIONS.md D-06 修订)。
# 首次运行会自动建库并应用迁移。
TEST_DATABASE_URL=postgresql+psycopg://mes:mes_dev_only@localhost:5432/meeting_evidence_test

# PostgreSQL 容器端口(docker-compose.yml 使用)
PG_PORT=5432

# API 服务
APP_HOST=127.0.0.1
APP_PORT=8000

# JWT 签发密钥(本地开发默认值即可运行;对外演示务必覆盖)
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRE_HOURS=12

# 上传限制
MAX_UPLOAD_MB=200
STORAGE_DIR=storage

# ---- 模型服务(Phase 1 起使用;留空 = 使用 mock Provider)----
# 转写服务
ASR_PROVIDER=mock
# 文本生成服务
LLM_PROVIDER=mock
# 向量化服务
EMBED_PROVIDER=mock
# 真实服务的密钥仅通过环境变量注入,示例:
# LLM_API_KEY=
# LLM_BASE_URL=
