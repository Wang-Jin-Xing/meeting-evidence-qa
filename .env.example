# 复制为 .env 后按需修改;.env 已被 .gitignore 排除,禁止提交真实密钥。

# 数据库连接(PostgreSQL,无 SQLite 降级路径)
DATABASE_URL=postgresql+psycopg://mes:mes_dev_only@localhost:5432/meeting_evidence

# 独立测试库(仅 pytest 使用;应用运行时不读取)
# 必须显式配置且库名不得与 DATABASE_URL 相同,否则测试直接退出、
# 不执行任何 TRUNCATE(见 docs/DECISIONS.md D-06 修订)。
# 首次运行会自动建库并应用迁移。
TEST_DATABASE_URL=postgresql+psycopg://mes:mes_dev_only@localhost:5432/meeting_evidence_test

# PostgreSQL 容器端口(docker-compose.yml 使用)
PG_PORT=5432

# API 监听地址/端口不在这里配:由命令行决定,
# 例如 scripts/dev_up.ps1 -Port 8100(内部传给 uvicorn --host/--port)。

# JWT 签发密钥(本地开发默认值即可运行;对外演示务必覆盖)
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRE_HOURS=12

# 上传限制
MAX_UPLOAD_MB=200
STORAGE_DIR=storage

# ---- 模型服务:API / worker / 脚本共用本文件(新开终端不必再 $env: 设置)----
# 取值见 app/ai/registry.py;未知取值直接报错,不会回退 mock。
# 全 mock(无需模型权重,适合常规开发与测试):
#   ASR_PROVIDER=mock  LLM_PROVIDER=mock  EMBED_PROVIDER=mock
# 真实组合(本机已验证:whisper + DeepSeek + bge-m3):
ASR_PROVIDER=whisper
LLM_PROVIDER=deepseek
EMBED_PROVIDER=bge-m3

# 证据阈值:随 Embedding 模型校准。mock bigram 用 0.15;
# bge-m3 在本项目语料上用 0.66(标定见 docs/DECISIONS.md D-48)。
QA_EVIDENCE_THRESHOLD=0.66
# 本地模型权重下载镜像(huggingface.co 直连在本机超时)
HF_ENDPOINT=https://hf-mirror.com
# worker 租约:真实 ASR/Embedding 单次处理较慢,放宽避免误判卡死
WORKER_LEASE_TTL_SECONDS=600
# 可选 Provider 取值(见 app/ai/registry.py;未知取值直接报错,不回退 mock):
#   ASR_PROVIDER   = mock | whisper(本地 faster-whisper)
#   EMBED_PROVIDER = mock | bge-m3(本地 BAAI/bge-m3,1024 维与向量列一致)
#   LLM_PROVIDER   = mock | deepseek
# 换 Embedding 模型必须重校准证据阈值:mock 实测 0.15;
# 本地 bge-m3 在演示数据上实测不相关句相似度约 0.39-0.55、金标句 0.71-0.82,
# 建议 QA_EVIDENCE_THRESHOLD=0.66(标定过程见 demo/verify_real_embedding.py)
# QA_EVIDENCE_THRESHOLD=0.15
# 本地模型权重下载走镜像(huggingface.co 直连在本机超时)
# HF_ENDPOINT=https://hf-mirror.com
# 权重缓存目录(bge-m3 + faster-whisper 约 4.8GB)。不设 = HuggingFace 默认位置,
# Windows 下落在 C:\Users\<你>\.cache\huggingface;系统盘紧张时请指到别的盘:
# HF_HOME=D:/model-cache/huggingface

# 真实服务的密钥仅通过环境变量注入,示例:
# LLM_API_KEY=
# LLM_BASE_URL=
