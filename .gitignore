# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 环境与密钥(禁止提交)
.env
*.pem
*.key

# 测试与缓存
.pytest_cache/
.coverage
htmlcov/

# 运行时数据(不提交任何上传音频与产物)
storage/

# 评测运行产物(报告与临时语料,可随时由 eval/run_eval.py 重新生成)
eval/reports/
eval/.work/

# 测试期 worker 子进程 stderr(仅用于失败诊断,可随时重生成)
.pytest_worker_logs/

# 前端(Phase 1 创建)
frontend/node_modules/
frontend/dist/

# IDE
.idea/
.vscode/

# 交接包(Git bundle,仓库自身不能包含自己)
handoff/

# 数据库备份(含演示与真实录音数据,不入库)
backups/

# 常驻服务运行日志(dev_up.ps1)
.run/
